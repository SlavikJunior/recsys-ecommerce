<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.recsys.node-exporter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node_exporter/bin/node_exporter</string>
    <string>--web.listen-address=127.0.0.1:9100</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT__/artifacts/logs/node_exporter.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/artifacts/logs/node_exporter.err.log</string>
</dict>
</plist>
