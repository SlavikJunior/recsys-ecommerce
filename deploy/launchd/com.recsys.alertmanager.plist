<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.recsys.alertmanager</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT__/deploy/bin/alertmanager</string>
    <string>--config.file=__PROJECT__/deploy/alertmanager.yml</string>
    <string>--storage.path=__PROJECT__/deploy/data/alertmanager</string>
    <string>--web.listen-address=127.0.0.1:9093</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT__/artifacts/logs/alertmanager.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/artifacts/logs/alertmanager.err.log</string>
</dict>
</plist>
